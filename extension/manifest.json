{
  "manifest_version": 3,
  "name": "Stashling",
  "version": "0.1.0",
  "description": "Exports your own saved items (lists, likes, watchlists) from sites you are logged into, to open files you keep on your own machine.",
  "homepage_url": "https://github.com/krausstt/stashling",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Stashling"
  },
  "options_ui": {
    "page": "ui/collection.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "sw.js",
    "type": "module",
    "scripts": ["sw.js"]
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "unlimitedStorage",
    "downloads"
  ],
  "optional_host_permissions": [
    "https://makerworld.com/*",
    "https://*.bblmw.com/*",
    "https://*.youtube.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "stashling@stashling.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
